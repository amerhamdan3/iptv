# Copy this file to ".env" and fill in your own provider details.
# .env is gitignored - it never leaves your machine.

# From your IPTV provider. The host is the portal address including the port.
XTREAM_HOST=http://your-provider-host:8080
XTREAM_USER=your-username
XTREAM_PASS=your-password

# Local web UI
HOST=127.0.0.1
PORT=8000

# Downloads. Automatically capped to the connection limit your provider
# reports, so this is an upper bound rather than a guarantee.
MAX_CONCURRENT_DOWNLOADS=2
DOWNLOAD_DIR=downloads

# How old the cached catalog may get before a background refresh
SYNC_INTERVAL_HOURS=24
